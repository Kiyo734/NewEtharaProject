# Database Configurations
POSTGRES_DB=inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# Backend Configurations
# Note: connect to the 'db' container name instead of localhost inside docker network
DATABASE_URL=postgresql://postgres:postgres_secure_pass@db:5432/inventory
ALLOWED_HOSTS=*

# Frontend Configurations
# Points to the Backend API URL accessed from the client's browser (usually localhost:8000)
VITE_API_URL=http://localhost:8000
